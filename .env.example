# --- OpenRouter: LLM, эмбеддинги и реранкер (обязательно) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель для генерации ответа
LLM_MODEL=openai/gpt-4.1-mini
# Плотные эмбеддинги и их размерность (должна совпадать с моделью)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Модель-реранкер (POST /rerank)
RERANK_MODEL=cohere/rerank-v3.5

# --- BM25 (локально, fastembed) ---
SPARSE_MODEL=Qdrant/bm25
# Язык стемминга и стоп-слов
SPARSE_LANGUAGE=russian
# Каталог кеша модели (в Docker-образе модель запечена сюда)
FASTEMBED_CACHE_DIR=

# --- Гибридный поиск ---
# Кандидатов из dense-ветви и из BM25-ветви
DENSE_LIMIT=50
SPARSE_LIMIT=50
# Способ объединения ветвей в Qdrant: rrf | dbsf
FUSION=rrf

# --- Реранк ---
# Сколько кандидатов подаётся на реранкер
RERANK_CANDIDATES=100
# Сколько фрагментов после реранка идёт в LLM
RERANK_TOP_N=5
# Минимальный score реранкера; если лучший ниже — "нет сведений" без вызова LLM
RERANK_MIN_SCORE=0.1

# --- Разбиение на фрагменты (символы) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBED_BATCH_SIZE=64

# --- Подключения ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads

# --- Ограничения и устойчивость ---
MAX_UPLOAD_MB=50
MAX_PAGES=100
MAX_QUESTION_CHARS=2000
# Попыток при временной недоступности LLM / Qdrant / реранкера
RETRY_ATTEMPTS=4
HTTP_TIMEOUT_S=60
